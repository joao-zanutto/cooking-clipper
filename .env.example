# Cooking Clipper — Configuration

CLIP_DURATION=1           # Length of each extracted clip in seconds
MOTION_THRESHOLD=0.10       # Minimum peak score as a fraction of the highest peak (0.0–1.0)
                            # Lower = more clips (more sensitive), Higher = fewer clips (stricter)
CHANGE_THRESHOLD=20         # Pixel intensity threshold for "significant" motion (5–50)
                            # Lower = detects subtle movements, Higher = ignores small changes
BLANKING_GAP=0.5            # Minimum gap between clips in seconds (avoids overlap)
OUTPUT_DIR=output           # Where to save the final video
MAX_WORKERS=                # Parallel workers for motion analysis (empty = auto)

# S3-compatible storage (SeaweedFS, MinIO, AWS S3, …)
S3_ENDPOINT=http://seaweedfs.local:8333   # S3 endpoint URL
S3_REGION=us-east-1                       # S3 region
S3_ACCESS_KEY_ID=                         # Access key (leave blank for anonymous / env)
S3_SECRET_ACCESS_KEY=                     # Secret key (leave blank for anonymous / env)
S3_SPLIT_SUFFIX=_Split                    # Suffix inserted before extension in output key
